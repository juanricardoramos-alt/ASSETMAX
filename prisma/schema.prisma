// ASSETMAX Global — data model
//
// NOTE ON PORTABILITY: the schema uses String columns (with typed constants in
// lib/constants.ts) instead of Prisma enums so the exact same schema runs on
// SQLite in development and PostgreSQL in production. To migrate, switch the
// datasource provider to "postgresql" and set DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users & auth
// ---------------------------------------------------------------------------

// role: SELLER | INVESTOR | PARTNER | ADMIN | SUPPLIER
model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  passwordHash   String?
  role           String    @default("INVESTOR")
  company        String?
  country        String?
  phone          String?
  verifiedSeller Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  projects       Project[]
  favorites      Favorite[]
  offers         Offer[]
  ndaAcceptances NdaAcceptance[]
  alerts         Alert[]
  investorThreads Thread[] @relation("InvestorThreads")
  sellerThreads   Thread[] @relation("SellerThreads")
  messages       Message[]
  mandates          Mandate[]
  commodityListings CommodityListing[]
  commodityNdas     CommodityNda[]
  contractsAsSeller Contract[] @relation("ContractSeller")
  contractsAsBuyer  Contract[] @relation("ContractBuyer")
  notifications     Notification[]
  companyProfile    CompanyProfile?
  supplierProfile   SupplierProfile?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Corporate profiles (anchor companies & project owners)
// ---------------------------------------------------------------------------

// Enterprise-level corporate profile. `verified` and `isAnchor` are set only
// by admins: anchors are the large demand-side companies (TLP Pipeline,
// Andrade Gutiérrez, TBEA…) whose published needs drive the supplier network.
// sector reuses the project category keys.
model CompanyProfile {
  id          String   @id @default(cuid())
  slug        String   @unique
  userId      String   @unique
  name        String
  legalName   String?
  description String
  sector      String
  country     String
  countryCode String
  city        String?
  website     String?
  founded     Int?
  employees   Int?
  logoUrl     String?
  verified    Boolean  @default(false)
  isAnchor    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  needs Need[]
}

// Procurement needs published by companies — the demand side that the
// qualified supplier registry applies to.
// category: supplier category key (SUPPLIER_CATEGORIES in lib/constants.ts)
// status: OPEN | CLOSED
model Need {
  id           String    @id @default(cuid())
  slug         String    @unique
  title        String
  description  String
  category     String
  companyId    String
  country      String
  countryCode  String
  city         String?
  budgetMin    Float?
  budgetMax    Float?
  deadline     DateTime?
  // JSON-encoded string array (portable across SQLite & Postgres)
  requirements String    @default("[]")
  status       String    @default("OPEN")
  views        Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company      CompanyProfile        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications SupplierApplication[]
  consortiums  Consortium[]
}

// ---------------------------------------------------------------------------
// Supplier registry (the qualified supply side)
// ---------------------------------------------------------------------------

// Suppliers register, get qualified by the platform team (admin review), and
// can then apply to published needs.
// category: SUPPLIER_CATEGORIES key · status: IN_REVIEW | PUBLISHED | REJECTED
model SupplierProfile {
  id              String   @id @default(cuid())
  slug            String   @unique
  userId          String   @unique
  name            String
  description     String
  category        String
  country         String
  countryCode     String
  city            String?
  website         String?
  employees       Int?
  yearsActive     Int?
  // JSON-encoded string arrays (portable across SQLite & Postgres)
  certifications  String   @default("[]")
  portfolio       String   @default("[]")
  capacity        String?
  status          String   @default("IN_REVIEW")
  verified        Boolean  @default(false)
  rejectionReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications   SupplierApplication[]
  ledConsortiums Consortium[]          @relation("ConsortiumLeader")
  memberships    ConsortiumMember[]
}

// A qualified supplier's application to a published need. When filed on
// behalf of a consortium, `consortiumId` links the joint bid and `supplierId`
// is the consortium leader.
// status: PENDING | IN_DISCUSSION | ACCEPTED | DECLINED | WITHDRAWN
model SupplierApplication {
  id             String   @id @default(cuid())
  needId         String
  supplierId     String
  consortiumId   String?
  message        String
  proposedBudget Float?
  leadTime       String?
  status         String   @default("PENDING")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  need       Need            @relation(fields: [needId], references: [id], onDelete: Cascade)
  supplier   SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  consortium Consortium?     @relation(fields: [consortiumId], references: [id], onDelete: SetNull)

  @@unique([needId, supplierId])
}

// A joint-bid vehicle: complementary qualified suppliers grouped to apply
// together to a large need. The anchor company sees one candidacy with the
// member detail; the leader files and manages the application.
model Consortium {
  id          String   @id @default(cuid())
  name        String
  needId      String
  leaderId    String
  createdAt   DateTime @default(now())

  need    Need            @relation(fields: [needId], references: [id], onDelete: Cascade)
  leader  SupplierProfile @relation("ConsortiumLeader", fields: [leaderId], references: [id], onDelete: Cascade)
  members      ConsortiumMember[]
  applications SupplierApplication[]
}

// role: free text describing the member's scope inside the consortium
// (e.g. "Civil works", "Heavy logistics").
model ConsortiumMember {
  id           String  @id @default(cuid())
  consortiumId String
  supplierId   String
  role         String?

  consortium Consortium      @relation(fields: [consortiumId], references: [id], onDelete: Cascade)
  supplier   SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([consortiumId, supplierId])
}

// ---------------------------------------------------------------------------
// Projects
// ---------------------------------------------------------------------------

// category: mining | energy | water | agro | manufacturing | infrastructure | ports | realestate
// stage: greenfield | construction | operating | expansion
// dealType: full_sale | partial_sale | capital_raise | joint_venture
// status: DRAFT | IN_REVIEW | PUBLISHED | REJECTED
model Project {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  summary         String
  description     String
  category        String
  country         String
  countryCode     String
  city            String?
  region          String?
  lat             Float?
  lng             Float?
  stage           String
  dealType        String
  status          String    @default("DRAFT")
  verified        Boolean   @default(false)
  featured        Boolean   @default(false)
  investmentMin   Float?
  investmentMax   Float?
  revenue         Float?
  ebitda          Float?
  capacity        String?
  production      String?
  permits         String?
  workforce       Int?
  areaHectares    Float?
  // JSON-encoded string arrays / objects (portable across SQLite & Postgres)
  highlights      String    @default("[]")
  specs           String    @default("[]")
  views           Int       @default(0)
  rejectionReason String?
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  images         ProjectImage[]
  documents      ProjectDocument[]
  favorites      Favorite[]
  offers         Offer[]
  ndaAcceptances NdaAcceptance[]
  threads        Thread[]
  matches        ProjectMatch[]
  contracts      Contract[]
}

model ProjectImage {
  id        String @id @default(cuid())
  projectId String
  url       String
  alt       String @default("")
  order     Int    @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectDocument {
  id             String  @id @default(cuid())
  projectId      String
  name           String
  url            String
  isConfidential Boolean @default(false)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Investor interactions
// ---------------------------------------------------------------------------

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
}

// type: full_acquisition | equity_stake | debt | joint_venture
// status: PENDING | IN_DISCUSSION | ACCEPTED | DECLINED | WITHDRAWN
model Offer {
  id         String   @id @default(cuid())
  projectId  String
  investorId String
  amount     Float
  type       String
  equityPct  Float?
  message    String
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  investor User    @relation(fields: [investorId], references: [id], onDelete: Cascade)

  contracts Contract[]
}

// Digital NDA acceptance — grants access to the project's data room.
model NdaAcceptance {
  id         String   @id @default(cuid())
  projectId  String
  userId     String
  fullName   String
  company    String?
  acceptedAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

// ---------------------------------------------------------------------------
// Messaging
// ---------------------------------------------------------------------------

// A thread belongs to either a project or a commodity listing (one of the two FKs set).
model Thread {
  id                 String   @id @default(cuid())
  projectId          String?
  commodityListingId String?
  investorId         String
  sellerId           String
  subject            String
  lastMessageAt      DateTime @default(now())
  createdAt          DateTime @default(now())

  project          Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  commodityListing CommodityListing? @relation(fields: [commodityListingId], references: [id], onDelete: Cascade)
  investor         User              @relation("InvestorThreads", fields: [investorId], references: [id], onDelete: Cascade)
  seller           User              @relation("SellerThreads", fields: [sellerId], references: [id], onDelete: Cascade)
  messages         Message[]

  @@unique([projectId, investorId])
  @@unique([commodityListingId, investorId])
}

model Message {
  id        String   @id @default(cuid())
  threadId  String
  senderId  String
  body      String
  createdAt DateTime @default(now())

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User   @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Buy-side investment mandates & AI matching
// ---------------------------------------------------------------------------

// status reuses: DRAFT | IN_REVIEW | PUBLISHED | REJECTED
model Mandate {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  description     String
  investorId      String
  // JSON-encoded string arrays of criteria keys (portable across SQLite & Postgres)
  categories      String   @default("[]")
  countries       String   @default("[]")
  stages          String   @default("[]")
  dealTypes       String   @default("[]")
  ticketMin       Float?
  ticketMax       Float?
  equityMin       Float?
  equityMax       Float?
  conditions      String?
  isPublic        Boolean  @default(true)
  status          String   @default("IN_REVIEW")
  rejectionReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  investor User           @relation(fields: [investorId], references: [id], onDelete: Cascade)
  matches  ProjectMatch[]
}

// status: NEW | CONTACTED | DISMISSED
model ProjectMatch {
  id        String   @id @default(cuid())
  projectId String
  mandateId String
  score     Int
  rationale String
  status    String   @default("NEW")
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mandate Mandate @relation(fields: [mandateId], references: [id], onDelete: Cascade)

  @@unique([projectId, mandateId])
}

// ---------------------------------------------------------------------------
// Physical commodities marketplace (connect, not transact)
// ---------------------------------------------------------------------------

// side: SELL | BUY · periodicity: spot | contract · priceType: fixed | indexed
model CommodityListing {
  id               String    @id @default(cuid())
  slug             String    @unique
  side             String
  commodity        String
  title            String
  description      String
  specs            String    @default("[]")
  volume           String
  periodicity      String
  originCode       String?
  destinationCode  String?
  incoterm         String
  deliveryLocation String?
  priceType        String
  priceDetails     String?
  validUntil       DateTime?
  documents        String    @default("[]")
  status           String    @default("IN_REVIEW")
  verified         Boolean   @default(false)
  rejectionReason  String?
  views            Int       @default(0)
  ownerId          String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  owner         User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ndaAcceptances CommodityNda[]
  threads       Thread[]
  contracts     Contract[]
  matchesAsSell CommodityMatch[] @relation("SellSide")
  matchesAsBuy  CommodityMatch[] @relation("BuySide")
}

model CommodityNda {
  id         String   @id @default(cuid())
  listingId  String
  userId     String
  fullName   String
  company    String?
  acceptedAt DateTime @default(now())

  listing CommodityListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([listingId, userId])
}

// status: NEW | CONTACTED | DISMISSED
model CommodityMatch {
  id        String   @id @default(cuid())
  sellId    String
  buyId     String
  score     Int
  rationale String
  status    String   @default("NEW")
  createdAt DateTime @default(now())

  sell CommodityListing @relation("SellSide", fields: [sellId], references: [id], onDelete: Cascade)
  buy  CommodityListing @relation("BuySide", fields: [buyId], references: [id], onDelete: Cascade)

  @@unique([sellId, buyId])
}

// ---------------------------------------------------------------------------
// AI-drafted contracts
// ---------------------------------------------------------------------------

// kind: NDA | LOI | MOU | SPA | COMMODITY_SPA
// Draft lifecycle: both parties must mark reviewed before download for signature.
model Contract {
  id                 String    @id @default(cuid())
  kind               String
  title              String
  content            String
  projectId          String?
  offerId            String?
  commodityListingId String?
  sellerId           String
  buyerId            String
  sellerReviewedAt   DateTime?
  buyerReviewedAt    DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  project          Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  offer            Offer?            @relation(fields: [offerId], references: [id], onDelete: Cascade)
  commodityListing CommodityListing? @relation(fields: [commodityListingId], references: [id], onDelete: Cascade)
  seller           User              @relation("ContractSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  buyer            User              @relation("ContractBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// In-app notifications
// ---------------------------------------------------------------------------

// type: MATCH | OFFER | MESSAGE | CONTRACT | REVIEW | APPLICATION
model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Saved search alerts
// ---------------------------------------------------------------------------

model Alert {
  id            String   @id @default(cuid())
  userId        String
  name          String
  category      String?
  country       String?
  stage         String?
  dealType      String?
  minInvestment Float?
  maxInvestment Float?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
