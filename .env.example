# Database — PostgreSQL (Supabase in production)
#
# Copy this file to .env and set your connection string. NEVER commit .env.
# Local development: any PostgreSQL 14+ works, e.g.
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vortamax"
#
# Supabase: use the direct connection (port 5432) for migrations/seed.
# If you point the app at the transaction pooler (port 6543), append
# `?pgbouncer=true&connection_limit=1` for Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional — sign-in with Google is enabled only when both are set)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
