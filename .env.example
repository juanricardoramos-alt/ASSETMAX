# Database
# Development (SQLite):
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL, e.g. Vercel Postgres / Neon / Supabase):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/assetmax?schema=public"

# NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional — sign-in with Google is enabled only when both are set)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
