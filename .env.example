# Database — PostgreSQL (production runs on Supabase)
# App runtime: the Supabase pooled URL (port 6543) works if you append
#   ?pgbouncer=true&connection_limit=1
# Migrations & seed need a DIRECT connection (port 5432). Set it explicitly:
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
# DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/postgres"

# NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional — sign-in with Google is enabled only when both are set)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Anthropic API (optional — AI ingestion, matching copy, translation and the
# project assistant activate when set; everything degrades gracefully without it)
ANTHROPIC_API_KEY=""
