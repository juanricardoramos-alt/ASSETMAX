# Database — PostgreSQL (production runs on Supabase)
# App runtime: the Supabase TRANSACTION pooler (port 6543) with
#   ?pgbouncer=true&connection_limit=1
# Migrations & seed: the SESSION pooler — same host and user, port 5432,
# no pgbouncer params (the db.<ref>.supabase.co direct host is IPv6-only and
# unreachable from IPv4 environments like Vercel). deploy-db derives it
# automatically from DATABASE_URL; set DIRECT_DATABASE_URL to override.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
# DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional — sign-in with Google is enabled only when both are set)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Anthropic API (optional — AI ingestion, matching copy, translation and the
# project assistant activate when set; everything degrades gracefully without it)
ANTHROPIC_API_KEY=""
