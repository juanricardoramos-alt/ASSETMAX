# Database — PostgreSQL (production runs on Neon)
# Use the connection string from your provider. With Neon, the pooled URL
# ("-pooler" host) works for the app; migrations derive the direct URL
# automatically (or set DIRECT_DATABASE_URL explicitly).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"
# DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@DIRECT_HOST/dbname?sslmode=require"

# NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional — sign-in with Google is enabled only when both are set)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Anthropic API (optional — AI ingestion, matching copy, translation and the
# project assistant activate when set; everything degrades gracefully without it)
ANTHROPIC_API_KEY=""
